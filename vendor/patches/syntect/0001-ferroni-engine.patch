+// Ferroni, a pure-Rust port of Oniguruma, with the onig backend's syntax
+// (Oniguruma's own, its default) and options. It wins over the other two.
+#[cfg(feature = "regex-ferroni")]
+mod regex_impl {
+    use ferroni::api::{RegexBuilder, Syntax};
+    use std::error::Error;
+
+    #[derive(Debug)]
+    pub struct Regex {
+        /// `None` for a pattern that never matches.
+        regex: Option<ferroni::api::Regex>,
+    }
+
+    #[derive(Clone, Debug, Eq, PartialEq)]
+    pub struct Region {
+        positions: Vec<Option<(usize, usize)>>,
+    }
+
+    pub fn new_region() -> Region {
+        Region {
+            positions: Vec::with_capacity(8),
+        }
+    }
+
+    impl Regex {
+        pub fn new(regex_str: &str) -> Result<Regex, Box<dyn Error + Send + Sync + 'static>> {
+            let result = RegexBuilder::new(regex_str)
+                .syntax_mode(Syntax::Oniguruma)
+                .capture_group(true)
+                .build();
+            match result {
+                Ok(regex) => Ok(Regex { regex: Some(regex) }),
+                Err(error) => Err(Box::new(error)),
+            }
+        }
+
+        /// One that never matches, in place of a pattern refused.
+        pub fn never() -> Regex {
+            Regex { regex: None }
+        }
+
+        pub fn is_match(&self, text: &str) -> bool {
+            self.regex.as_ref().is_some_and(|regex| regex.is_match(text))
+        }
+
+        pub fn search(
+            &self,
+            text: &str,
+            begin: usize,
+            end: usize,
+            region: Option<&mut Region>,
+        ) -> bool {
+            // A search stopped by a limit is no match, as with onig.
+            let Some(captures) = self
+                .regex
+                .as_ref()
+                .and_then(|regex| regex.captures_at(&text[..end], begin))
+            else {
+                return false;
+            };
+            if let Some(region) = region {
+                region.positions.clear();
+                for i in 0..captures.len() {
+                    region
+                        .positions
+                        .push(captures.get(i).map(|m| (m.start(), m.end())));
+                }
+            }
+            true
+        }
+    }
+
+    impl Region {
+        pub fn pos(&self, i: usize) -> Option<(usize, usize)> {
+            self.positions.get(i).copied().flatten()
+        }
+    }
+}
 
