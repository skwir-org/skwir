+        let state = ListState::new(2, crate::ListAlignment::Top, px(100.));
+        let view = cx.update(|_, cx| {
+            cx.new(|_| InferredView {
+                state: state.clone(),
+                around: |list| {
+                    div()
+                        .flex()
+                        .flex_col()
