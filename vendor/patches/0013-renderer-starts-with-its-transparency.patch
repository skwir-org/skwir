0013 renderer-starts-with-its-transparency: WindowParams carry the background and decorations

diff --git a/crates/gpui/src/platform.rs b/crates/gpui/src/platform.rs
index 0df9d10..746897e 100644
--- a/crates/gpui/src/platform.rs
+++ b/crates/gpui/src/platform.rs
@@ -2734,6 +2734,14 @@ pub struct WindowParams {
 
     pub window_min_size: Option<Size<Pixels>>,
 
+    /// The background the window opens with and the decorations it asks
+    /// for, which the window sets once it is open: a renderer can start
+    /// with the transparency they give instead of switching to it.
+    #[cfg_attr(not(feature = "wayland"), allow(dead_code))]
+    pub window_background: WindowBackgroundAppearance,
+    #[cfg_attr(not(feature = "wayland"), allow(dead_code))]
+    pub window_decorations: Option<WindowDecorations>,
+
     #[cfg(target_os = "macos")]
     pub tabbing_identifier: Option<String>,
 
diff --git a/crates/gpui/src/window.rs b/crates/gpui/src/window.rs
index cc2a9a7..1a5f5a5 100644
--- a/crates/gpui/src/window.rs
+++ b/crates/gpui/src/window.rs
@@ -1664,6 +1664,8 @@ impl Window {
                 show,
                 display_id,
                 window_min_size,
+                window_background,
+                window_decorations,
                 app_id: app_id.clone(),
                 icon,
                 #[cfg(target_os = "macos")]
diff --git a/crates/gpui_linux/src/linux/wayland/window.rs b/crates/gpui_linux/src/linux/wayland/window.rs
index 8d92234..e397b04 100644
--- a/crates/gpui_linux/src/linux/wayland/window.rs
+++ b/crates/gpui_linux/src/linux/wayland/window.rs
@@ -575,12 +575,21 @@ impl WaylandWindowState {
                     .display_ptr()
                     .cast::<c_void>(),
             };
+            // As `is_transparent` will say once the window has asked for its
+            // decorations and set its background: starting otherwise, the
+            // renderer would configure its surface and build its pipelines
+            // again before the first frame.
+            let transparent = options
+                .window_decorations
+                .unwrap_or(WindowDecorations::Server)
+                == WindowDecorations::Client
+                || options.window_background != WindowBackgroundAppearance::Opaque;
             let config = WgpuSurfaceConfig {
                 size: Size {
                     width: DevicePixels(f32::from(options.bounds.size.width) as i32),
                     height: DevicePixels(f32::from(options.bounds.size.height) as i32),
                 },
-                transparent: true,
+                transparent,
                 // Prefer Mailbox to avoid blocking. Falls back to FIFO if Mailbox is unsupported.
                 preferred_present_mode: Some(wgpu::PresentMode::Mailbox),
             };
