+    /// Get the FontId for the configure font family and style, or an error
+    /// when it cannot be loaded: asked without falling back, so a caller can
+    /// tell whether a family is installed (`resolve_font` panics when
+    /// neither it nor a fallback is).
+    pub fn font_id(&self, font: &Font) -> Result<FontId> {
+        let cached = self.font_ids_by_font.read().get(font).cloned();
+        match cached {
+            Some(CachedFont::Direct(font_id)) => Ok(font_id),
+            // Resolved to a fallback: the font itself failed to load.
+            Some(CachedFont::Fallback(_)) => Err(anyhow::anyhow!("font {font:?} is not available")),
+            Some(CachedFont::Missing(error)) => Err(anyhow::anyhow!("{error:#}")),
+            None => {
+                let font_id = self.platform_text_system.font_id(font);
+                let cached = match &font_id {
+                    Ok(font_id) => CachedFont::Direct(*font_id),
+                    Err(error) => CachedFont::Missing(Arc::new(anyhow::anyhow!("{error:#}"))),
+                };
+                self.font_ids_by_font
+                    .write()
+                    .entry(font.clone())
+                    .or_insert(cached);
+                font_id
+            }
+        }
+    }
+
