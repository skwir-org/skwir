+    fn ground(mut self, ground: impl Into<Hsla>, ink: impl Into<Hsla>) -> Self
+    where
+        Self: Sized,
+    {
+        let ground = ground.into();
+        self.style().background = Some(ground.into());
+        self.style().ink = Some(crate::Ink {
