+    /// A run read right to left is placed as DirectWrite draws it, from
+    /// its origin leftward (zed#31102), and a line that starts right to
+    /// left reads so: gpui takes it from its left and answers carets as it
+    /// reads.
+    #[test]
+    fn right_to_left_runs_are_placed_as_drawn() -> Result<()> {
+        let platform_text_system = Arc::new(DirectWriteTextSystem::new(None)?);
+        // Windows' interface font, which draws Hebrew. (Under Wine 11 no
+        // font is selected at all, this one or another.)
+        let font = Font {
+            family: "Segoe UI".into(),
+            ..Default::default()
+        };
+        platform_text_system.font_id(&font)?;
+        let text_system = WindowTextSystem::new(Arc::new(TextSystem::new(platform_text_system)));
+        let shape = |text: &str| {
+            let runs = [TextRun {
+                len: text.len(),
+                font: font.clone(),
+                ..Default::default()
+            }];
+            text_system.shape_line(text.to_string().into(), px(14.0), &runs, None)
+        };
+        // "אבג abc": "abc" on the left, then the space, then "גבא".
+        let text = "\u{5d0}\u{5d1}\u{5d2} abc";
+        let line = shape(text);
+        let glyphs: Vec<_> = line.runs.iter().flat_map(|run| &run.glyphs).collect();
+        let indices: Vec<usize> = glyphs.iter().map(|glyph| glyph.index).collect();
+        assert_eq!(indices, [7, 8, 9, 6, 4, 2, 0]);
+        assert!(
+            glyphs
+                .windows(2)
+                .all(|pair| pair[0].position.x < pair[1].position.x)
+        );
+        assert!(glyphs[0].position.x.abs() < px(0.5));
+        assert!(line.is_right_to_left());
+        assert_eq!(line.closest_index_for_x(line.width), 0);
+        assert_eq!(line.x_for_index(text.len()), glyphs[3].position.x);
+        // "abc אבג" reads left to right, its Hebrew word drawn reversed.
+        let text = "abc \u{5d0}\u{5d1}\u{5d2}";
+        let line = shape(text);
+        let indices: Vec<usize> = line
+            .runs
+            .iter()
+            .flat_map(|run| run.glyphs.iter().map(|glyph| glyph.index))
+            .collect();
+        assert_eq!(indices, [0, 1, 2, 3, 8, 6, 4]);
+        assert!(!line.is_right_to_left());
+        // A line all left to right is placed as it always was.
+        let latin = shape("abc");
+        assert!(!latin.has_right_to_left());
+        assert!(latin.runs[0].glyphs[0].position.x.abs() < px(0.5));
+        Ok(())
+    }
