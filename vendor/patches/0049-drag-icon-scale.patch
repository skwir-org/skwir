0049 drag-icon-scale: a drag icon drawn at a scale is shown at its logical size

diff --git a/crates/gpui/src/interactive.rs b/crates/gpui/src/interactive.rs
index fec3ffc..396e13d 100644
--- a/crates/gpui/src/interactive.rs
+++ b/crates/gpui/src/interactive.rs
@@ -764,7 +764,7 @@ impl FileDragPaths {
 /// The image under the pointer during a native drag: RGBA8 with straight
 /// (not premultiplied) alpha, `width * height * 4` bytes, and the pixel that
 /// sits under the pointer.
-#[derive(Clone, Eq, PartialEq)]
+#[derive(Clone, PartialEq)]
 pub struct ExternalDragIcon {
     /// Width in pixels.
     pub width: u32,
@@ -776,8 +776,15 @@ pub struct ExternalDragIcon {
     pub hotspot_x: u32,
     /// Y of the pixel under the pointer.
     pub hotspot_y: u32,
+    /// How many of its pixels make one of the window's: 1 for an image
+    /// shown pixel for pixel, the window's scale factor for one drawn at
+    /// it, which the platform shows at its logical size, sharp.
+    pub scale: f32,
 }
 
+// A scale is a finite number.
+impl Eq for ExternalDragIcon {}
+
 impl Debug for ExternalDragIcon {
     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
         f.debug_struct("ExternalDragIcon")
@@ -785,6 +792,7 @@ impl Debug for ExternalDragIcon {
             .field("height", &self.height)
             .field("hotspot_x", &self.hotspot_x)
             .field("hotspot_y", &self.hotspot_y)
+            .field("scale", &self.scale)
             .finish_non_exhaustive()
     }
 }
diff --git a/crates/gpui_linux/src/linux/wayland/client.rs b/crates/gpui_linux/src/linux/wayland/client.rs
index 99b695f..84076ac 100644
--- a/crates/gpui_linux/src/linux/wayland/client.rs
+++ b/crates/gpui_linux/src/linux/wayland/client.rs
@@ -532,6 +532,11 @@ struct DragIcon {
     buffer: wl_buffer::WlBuffer,
     pool: wl_shm_pool::WlShmPool,
     _file: std::fs::File,
+    /// What shows an image drawn at a scale at its logical size.
+    viewport: Option<wp_viewport::WpViewport>,
+    /// The buffer's pixels for one of the surface's: the image's scale
