0042 list-overdraw-set-later: ListState::set_overdraw changes how much a list renders beyond its view, so a list about to scroll up by more than its overdraw can measure that far first and cross heights known, not hinted

diff --git a/crates/gpui/src/elements/list.rs b/crates/gpui/src/elements/list.rs
index 2ed8d3a..7119049 100644
--- a/crates/gpui/src/elements/list.rs
+++ b/crates/gpui/src/elements/list.rs
@@ -330,6 +330,16 @@ impl ListState {
         state
     }
 
+    /// Change how much is rendered beyond the visible area (see [`Self::new`]),
+    /// from the next layout on.
+    ///
+    /// Items in the overdraw above the scroll top are measured, so a list about
+    /// to scroll up by more than its overdraw can measure that far first: the
+    /// scroll then crosses items whose heights are known rather than estimated.
+    pub fn set_overdraw(&self, overdraw: Pixels) {
+        self.0.borrow_mut().overdraw = overdraw;
+    }
+
     /// Set the list to measure all items in the list in the first layout phase.
     ///
     /// This is useful for ensuring that the scrollbar size is correct instead of based on only rendered elements.
@@ -2150,6 +2160,58 @@ mod test {
         assert_eq!(state.max_offset_for_scrollbar().y, px(4800.));
     }
 
+    #[gpui::test]
+    fn test_overdraw_set_later_measures_that_far_above_the_top(cx: &mut TestAppContext) {
+        let cx = cx.add_empty_window();
+
+        // 10 items of 300px, hinted at 50px: a scroll over items not yet
+        // measured goes by their hints.
+        let state =
+            ListState::new(10, crate::ListAlignment::Top, px(0.)).with_uniform_item_height(px(50.));
+
+        struct TestView(ListState);
+        impl Render for TestView {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                list(self.0.clone(), |_, _, _| {
+                    div().h(px(300.)).w_full().into_any()
+                })
+                .w_full()
+                .h_full()
+            }
+        }
+
+        let view = cx.update(|_, cx| cx.new(|_| TestView(state.clone())));
+        let at_fifth = ListOffset {
+            item_ix: 5,
+            offset_in_item: px(0.),
+        };
+
+        // With no overdraw, nothing above the fifth item is measured: 400px up
+        // is eight hints of 50px, past the list's start.
+        state.scroll_to(at_fifth);
+        cx.draw(point(px(0.), px(0.)), size(px(100.), px(200.)), |_, _| {
+            view.clone().into_any_element()
+        });
+        state.scroll_by(px(-400.));
+        assert_eq!(state.logical_scroll_top().item_ix, 0);
+
+        // Given 400px of overdraw, the next layout measures the two items above
+        // it, and 400px up crosses item 4 and item 3's last 100px.
+        state.scroll_to(at_fifth);
+        state.set_overdraw(px(400.));
+        cx.draw(point(px(0.), px(0.)), size(px(100.), px(200.)), |_, _| {
+            view.into_any_element()
+        });
+        state.scroll_by(px(-400.));
+        assert_eq!(
+            state.logical_scroll_top(),
+            ListOffset {
+                item_ix: 3,
+                offset_in_item: px(200.),
+            }
+        );
+    }
+
     #[gpui::test]
     fn test_remeasure(cx: &mut TestAppContext) {
         let cx = cx.add_empty_window();
