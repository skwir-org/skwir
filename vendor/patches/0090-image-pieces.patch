+        let seen = painted.clone();
+        cx.draw(
+            point(px(0.), px(0.)),
+            AvailableSpace::max_size(),
+            move |_, _| {
+                canvas(
+                    |_, _, _| {},
+                    move |_, (), window, _| {
+                        let bounds = Bounds::new(point(px(0.), px(0.)), size(px(100.), px(10.)));
