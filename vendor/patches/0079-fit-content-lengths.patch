+/// A `Length` as long as its content, but no longer than `limit`: CSS's
+/// `fit-content(<length-percentage>)`.
+pub fn fit_content(limit: impl Into<DefiniteLength>) -> Length {
+    Length::FitContent(limit.into())
+}
