+/// A press cancels a tooltip still waiting to show: what the press opens (a
+/// menu, a dialog) is drawn by the time the delay ends, and the tooltip would
+/// stand over it until the pointer moves, its hover checked by bounds alone.
+fn cancel_waiting_tooltip(active_tooltip: &Rc<RefCell<Option<ActiveTooltip>>>) {
+    let waiting = matches!(
+        active_tooltip.borrow().as_ref(),
+        Some(ActiveTooltip::WaitingForShow { .. })
+    );
+    if waiting {
+        active_tooltip.borrow_mut().take();
+    }
+}
