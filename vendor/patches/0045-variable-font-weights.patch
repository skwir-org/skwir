+    /// `font_id`'s face drawn at `weight`: itself, or for a variable face
+    /// whose weight axis holds another weight, its instance there, loaded
+    /// once per weight (cosmic-text shapes it there: `get_font`).
+    fn at_weight(&mut self, font_id: FontId, key: &FontKey, weight: gpui::FontWeight) -> FontId {
+        let loaded = self.loaded_font(font_id);
+        let instance = loaded.instance(Weight(weight.0.round().clamp(1., 1000.) as u16));
+        if instance == loaded.weight {
+            return font_id;
+        }
+        let instance_key = LoadedFontKey {
+            database_id: loaded.font.id(),
+            font: key.clone(),
+            weight: instance,
+        };
+        let chain = Arc::clone(&loaded.user_fallback_chain);
+        if let Some(&id) = self.loaded_font_ids_by_key.get(&instance_key) {
+            // As `load_family` does when a family is loaded again.
+            self.loaded_fonts[id.0].user_fallback_chain = chain;
+            return id;
+        }
+        let Some(font) = self
+            .font_system
+            .get_font(instance_key.database_id, instance)
+        else {
+            return font_id;
+        };
+        let loaded = self.loaded_font(font_id);
+        let instance_font = LoadedFont::new(
+            font,
+            instance,
+            loaded.features.clone(),
+            loaded.is_known_emoji_font,
+            chain,
+        );
+        let id = FontId(self.loaded_fonts.len());
+        self.loaded_fonts.push(instance_font);
+        self.loaded_font_ids_by_key.insert(instance_key, id);
+        id
+    }
