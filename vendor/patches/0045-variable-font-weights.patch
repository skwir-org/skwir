+
+    /// The weight its face is drawn at when `weight` is asked: a variable
+    /// face's within its weight axis, any other face's own.
+    fn instance(&self, weight: Weight) -> Weight {
+        instance_weight(self.weight_axis, self.weight, weight)
+    }
+}
+
+/// A variable face's weight axis: its least and greatest weights. `None` for
+/// a face of one weight.
+fn weight_axis(font: &CosmicTextFont) -> Option<(f32, f32)> {
+    let axis = font.as_swash().variations().find_by_tag(WEIGHT_AXIS)?;
+    Some((axis.min_value(), axis.max_value()))
+}
+
+/// The weight a face is drawn at when `asked` is: within a variable face's
+/// weight axis (`axis`), else the face's own (`own`).
+fn instance_weight(axis: Option<(f32, f32)>, own: Weight, asked: Weight) -> Weight {
+    match axis {
+        Some((least, most)) => Weight(f32::from(asked.0).clamp(least, most).round() as u16),
+        None => own,
+    }
 }
 
