+    #[test]
+    fn a_variable_face_is_shaped_measured_and_drawn_at_the_weight_asked() -> Result<()> {
+        let text_system = CosmicTextSystem::new_without_system_fonts("Inter Variable");
+        text_system.add_fonts(vec![Cow::Borrowed(INTER_VARIABLE)])?;
+        let at = |weight| {
+            text_system.font_id(&Font {
+                weight,
+                ..gpui::font("Inter Variable")
+            })
+        };
+        let regular = at(gpui::FontWeight::NORMAL)?;
+        let semibold = at(gpui::FontWeight::SEMIBOLD)?;
+        let bold = at(gpui::FontWeight::BOLD)?;
+        // One face, a font for each weight asked, kept.
+        assert_ne!(regular, semibold);
+        assert_ne!(semibold, bold);
+        assert_eq!(at(gpui::FontWeight::BOLD)?, bold);
+        for (font_id, weight) in [
+            (regular, gpui::FontWeight::NORMAL),
+            (semibold, gpui::FontWeight::SEMIBOLD),
+            (bold, gpui::FontWeight::BOLD),
+            // Past its axis: its heaviest.
+            (at(gpui::FontWeight(1000.))?, gpui::FontWeight::BLACK),
+        ] {
+            assert_eq!(
+                text_system.font_weight_and_style(font_id)?,
+                (weight, gpui::FontStyle::Normal)
+            );
+        }
+
+        // Shaped there: a heavier line is wider, its glyphs the font asked's.
+        let width = |font_id| {
+            let text = "Hamburgefonstiv";
+            let runs = [FontRun {
+                len: text.len(),
+                font_id,
+                position: Default::default(),
+            }];
+            let layout = text_system.layout_line(text, gpui::px(14.), &runs);
+            assert!(layout.runs.iter().all(|run| run.font_id == font_id));
+            layout.width
+        };
+        assert!(width(regular) < width(semibold));
+        assert!(width(semibold) < width(bold));
+
+        // Measured there.
+        let h = text_system.glyph_for_char(bold, 'H').context("an H")?;
+        assert!(text_system.advance(regular, h)?.width < text_system.advance(bold, h)?.width);
+
+        // Drawn there: a bold H holds more ink than a regular one.
+        let (thin, heavy) = (
+            inked(&text_system, regular, h)?,
+            inked(&text_system, bold, h)?,
+        );
+        assert!(thin * 5 < heavy * 4, "regular {thin}, bold {heavy}");
+        Ok(())
+    }
