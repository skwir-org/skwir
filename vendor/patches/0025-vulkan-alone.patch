 #[cfg(not(target_family = "wasm"))]
+/// SKWIR: the context for a window's first surface, and that surface: on
+/// Vulkan alone where it offers a GPU ([`WgpuContext::vulkan_alone`]), else,
+/// or where none of its GPUs can draw to the window, on GL too.
+#[cfg(not(target_family = "wasm"))]
+fn first_context<W>(
+    window: &W,
+    raw_window_handle: raw_window_handle::RawWindowHandle,
+    compositor_gpu: Option<CompositorGpuHint>,
+    reject_software: bool,
+) -> anyhow::Result<(WgpuContext, wgpu::Surface<'static>)>
+where
+    W: HasWindowHandle + HasDisplayHandle + std::fmt::Debug + Send + Sync + Clone + 'static,
+{
+    let new = |instance: wgpu::Instance, surface: &wgpu::Surface<'_>| {
+        if reject_software {
+            WgpuContext::new_rejecting_software(instance, surface, compositor_gpu)
+        } else {
+            WgpuContext::new(instance, surface, compositor_gpu)
+        }
+    };
+    let (vulkan, has_a_gpu) = WgpuContext::vulkan_alone(Some(Box::new(window.clone())));
+    if has_a_gpu {
+        let surface = create_surface(&vulkan, raw_window_handle)
+            .map_err(|e| anyhow::anyhow!("Failed to create surface: {e}"))?;
+        match new(vulkan, &surface) {
+            Ok(context) => return Ok((context, surface)),
+            Err(error) => {
+                log::info!("Vulkan alone cannot draw to the window ({error}); trying GL too")
+            }
+        }
+    }
+    let instance = WgpuContext::instance(Some(Box::new(window.clone())));
+    let surface = create_surface(&instance, raw_window_handle)
+        .map_err(|e| anyhow::anyhow!("Failed to create surface: {e}"))?;
+    Ok((new(instance, &surface)?, surface))
+}
+
 fn create_surface(
     instance: &wgpu::Instance,
     raw_window_handle: raw_window_handle::RawWindowHandle,
