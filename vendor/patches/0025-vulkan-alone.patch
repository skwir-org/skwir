+    /// SKWIR: an instance of Vulkan alone, and whether Vulkan offers a GPU
+    /// there (an adapter other than a CPU's). An instance with the GL backend
+    /// loads the GL driver as well as Vulkan's: on NVIDIA, EGL and its GL
+    /// core, 16 MiB of mapped code, and time before the first frame. Where
+    /// Vulkan offers no GPU (no driver, or lavapipe alone beside a GPU that
+    /// only GL drives: an old one, a virtual machine's), the caller takes
+    /// [`Self::instance`], whose adapters are ranked GPU first.
+    #[cfg(not(target_family = "wasm"))]
+    pub fn vulkan_alone(
+        display: Option<Box<dyn wgpu::wgt::WgpuHasDisplayHandle>>,
+    ) -> (wgpu::Instance, bool) {
+        let vulkan = Self::instance_with(wgpu::Backends::VULKAN, display);
+        let has_a_gpu = gpui::block_on(vulkan.enumerate_adapters(wgpu::Backends::VULKAN))
+            .iter()
+            .any(|adapter| adapter.get_info().device_type != wgpu::DeviceType::Cpu);
+        (vulkan, has_a_gpu)
+    }
