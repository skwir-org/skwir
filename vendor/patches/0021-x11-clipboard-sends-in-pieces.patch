+    /// The requestor of an incremental transfer deleted its property: the
+    /// next piece, or the empty one that ends it.
+    fn continue_transfer(&self, event: &PropertyNotifyEvent) -> Result<()> {
+        if event.state != Property::DELETE {
+            return Ok(());
+        }
+        let mut transfers = self.transfers.lock();
+        let Some(index) = transfers.iter().position(|transfer| {
+            (transfer.requestor, transfer.property) == (event.window, event.atom)
+        }) else {
+            return Ok(());
+        };
+        let piece = self.max_property_bytes();
+        let transfer = &mut transfers[index];
+        let end = (transfer.sent + piece).min(transfer.bytes.len());
+        self.server
+            .conn
+            .change_property8(
+                PropMode::REPLACE,
+                transfer.requestor,
+                transfer.property,
+                transfer.format,
+                &transfer.bytes[transfer.sent..end],
+            )
+            .map_err(into_unknown)?;
+        if transfer.sent == end {
+            // The empty piece went: done, and its window no longer watched.
+            let transfer = transfers.remove(index);
+            self.server
+                .conn
+                .change_window_attributes(
+                    transfer.requestor,
+                    &ChangeWindowAttributesAux::new().event_mask(EventMask::NO_EVENT),
+                )
+                .map_err(into_unknown)?;
+        } else {
+            transfer.sent = end;
+            transfer.progress = Instant::now();
+        }
+        self.server.conn.flush().map_err(into_unknown)
+    }
