+    /// Answer `event` with INCR (ICCCM 2.7.2): the property says how much
+    /// is coming, and each piece follows once the requestor deleted the one
+    /// before (`continue_transfer`).
+    fn start_transfer(&self, event: &SelectionRequestEvent, data: &ClipboardData) -> Result<()> {
+        let mut transfers = self.transfers.lock();
+        transfers.retain(|transfer| {
+            transfer.progress.elapsed() < INCR_ABANDONED
+                && (transfer.requestor, transfer.property) != (event.requestor, event.property)
+        });
+        // Its PropertyNotify events come to this connection.
+        self.server
+            .conn
+            .change_window_attributes(
+                event.requestor,
+                &ChangeWindowAttributesAux::new().event_mask(EventMask::PROPERTY_CHANGE),
+            )
+            .map_err(into_unknown)?;
+        self.server
+            .conn
+            .change_property32(
+                PropMode::REPLACE,
+                event.requestor,
+                event.property,
+                self.atoms.INCR,
+                &[u32::try_from(data.bytes.len()).unwrap_or(u32::MAX)],
+            )
+            .map_err(into_unknown)?;
+        transfers.push(Transfer {
+            requestor: event.requestor,
+            property: event.property,
+            format: data.format,
+            bytes: data.bytes.clone(),
+            sent: 0,
+            progress: Instant::now(),
+        });
+        Ok(())
+    }
