+    /// A shortcut on a layout whose letters are not Latin is named by the
+    /// keymap's Latin layout, or a US one, never by the ASCII symbols its
+    /// keys type; a digit row's shortcut by its digit.
+    #[cfg(any(feature = "wayland", feature = "x11"))]
+    #[test]
+    fn a_shortcut_is_named_by_a_latin_layout() {
+        const CTRL: u32 = 37;
+        const SHIFT: u32 = 50;
+        const ALT: u32 = 64;
+        // Greek's `;` on Q, Hebrew's `'` on W: their US positions.
+        assert_eq!(named("gr", "", 0, &[CTRL], 24), "ctrl-q");
+        assert_eq!(named("il", "", 0, &[CTRL], 25), "ctrl-w");
+        // Russian's comma on the slash key, Shift held: the US `?`.
+        assert_eq!(named("ru", "", 0, &[CTRL, SHIFT], 61), "ctrl-?");
+        // Arabic's `~` on Shift+Z: the letter, Shift kept with it.
+        assert_eq!(named("ara", "", 0, &[CTRL, SHIFT], 52), "ctrl-shift-z");
+        // A keymap with a Latin layout names it so whichever is active.
+        assert_eq!(named("us,ru", "", 1, &[CTRL, SHIFT], 61), "ctrl-?");
+        assert_eq!(named("fr,ru", "", 1, &[ALT], 24), "alt-a");
+        // The digit row: AZERTY's `&`, Persian's `۱` are 1.
+        assert_eq!(named("fr", "", 0, &[CTRL], 10), "ctrl-1");
+        assert_eq!(named("fr", "", 0, &[CTRL, SHIFT], 10), "ctrl-1");
+        assert_eq!(named("ir", "", 0, &[CTRL], 10), "ctrl-1");
+        // A Latin layout's own keys, and keys held alone, as they were.
+        assert_eq!(named("de", "", 0, &[CTRL], 29), "ctrl-z");
+        assert_eq!(named("us", "", 0, &[CTRL, SHIFT], 10), "ctrl-!");
+        assert_eq!(named("us", "", 0, &[CTRL, SHIFT], 59), "ctrl-<");
+        assert_eq!(named("us", "", 0, &[], 61), "/");
+        assert_eq!(named("il", "", 0, &[], 24), "/");
+    }
+
+    /// The US positions a layout with no Latin letters takes: the digit row
+    /// and its symbols, the comma and period with Shift (`<` and `>`, which
+    /// were swapped).
+    #[cfg(any(feature = "wayland", feature = "x11"))]
+    #[test]
+    fn a_us_position_is_as_a_us_layout_has_it() {
+        let us = |code: u32, shift: bool| guess_ascii(Keycode::new(code), shift);
+        assert_eq!(us(10, false), Some('1'));
+        assert_eq!(us(19, false), Some('0'));
+        assert_eq!(us(10, true), Some('!'));
+        assert_eq!(us(19, true), Some(')'));
+        assert_eq!(us(20, true), Some('_'));
+        assert_eq!(us(21, false), Some('='));
+        assert_eq!(us(59, true), Some('<'));
+        assert_eq!(us(60, true), Some('>'));
+        // As a US keymap names them.
+        for code in (10..=21).chain(24..=35).chain(38..=49).chain(51..=61) {
+            for (shift, held) in [(false, &[37][..]), (true, &[37, 50][..])] {
+                if let Some(c) = us(code, shift) {
+                    let name = named("us", "", 0, held, code);
+                    let key = name.rsplit('-').next().unwrap_or(&name);
+                    let key = if name.ends_with("--") { "-" } else { key };
+                    assert_eq!(key, c.to_ascii_lowercase().to_string(), "{code} {shift}");
+                }
+            }
+        }
+    }
