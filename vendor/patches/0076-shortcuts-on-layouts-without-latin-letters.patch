+    fn named(layouts: &str, variants: &str, active: u32, held: &[u32], keycode: u32) -> String {
+        let context = xkb::Context::new(xkb::CONTEXT_NO_FLAGS);
+        let keymap = xkb::Keymap::new_from_names(
+            &context,
+            "evdev",
+            "pc105",
+            layouts,
+            variants,
+            None,
+            xkb::COMPILE_NO_FLAGS,
+        )
+        .expect("layouts of xkeyboard-config");
+        let mut state = State::new(&keymap);
+        state.update_mask(0, 0, 0, 0, 0, active);
+        for &key in held {
+            state.update_key(Keycode::new(key), xkb::KeyDirection::Down);
+        }
+        let modifiers = gpui::Modifiers {
+            control: held.contains(&37),
+            alt: held.contains(&64),
+            shift: held.contains(&50),
+            ..Default::default()
+        };
