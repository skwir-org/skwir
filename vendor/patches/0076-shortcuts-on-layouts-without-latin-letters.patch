+/// What names a shortcut's key (Control, Alt or Super held) on a layout
+/// whose letters are not Latin.
+#[cfg(any(feature = "wayland", feature = "x11"))]
+enum ShortcutKey {
+    /// The key's own: its layout is Latin.
+    Own,
+    /// What the key gives in the keymap's first Latin layout, at the level
+    /// the same modifiers give there.
+    Latin(xkb::LayoutIndex, Keysym),
+    /// What it gives on a US layout (`guess_ascii`): the keymap has no
+    /// Latin layout.
+    UsPosition,
+}
+
+/// What names a shortcut held at `keycode`: a layout of Greek, Cyrillic,
+/// Hebrew or Arabic letters names it as the keymap's first Latin layout
+/// does, or as a US layout does where it has none, never by its own
+/// ASCII symbols (Greek's `;` on Q, Hebrew's `'` on W).
+#[cfg(any(feature = "wayland", feature = "x11"))]
+fn shortcut_key(state: &State, keycode: Keycode) -> ShortcutKey {
+    let keymap = state.get_keymap();
+    let latin = latin_layouts(&keymap);
+    let layout = state.key_get_layout(keycode);
+    if latin.get(layout as usize).copied().unwrap_or(true) {
+        return ShortcutKey::Own;
+    }
+    let Some(first) = latin.iter().position(|is| *is) else {
+        return ShortcutKey::UsPosition;
+    };
+    let first = first as xkb::LayoutIndex;
+    let level = state.key_get_level(keycode, first);
+    match keymap.key_get_syms_by_level(keycode, first, level).first() {
+        Some(sym) => ShortcutKey::Latin(first, *sym),
+        None => ShortcutKey::UsPosition,
+    }
+}
+
+/// The digit a shortcut held on the digit row names, where the key gives
+/// none at its first level (AZERTY's `&` for 1, Persian's `۱`): the one a
+/// level of it gives, the lowest first, else its US digit. `None` off the
+/// row, and where its first level is a digit: a US or German layout's
+/// shifted digits keep their symbols' names (`ctrl-!`).
+#[cfg(any(feature = "wayland", feature = "x11"))]
+fn digit_of_row(state: &State, keycode: Keycode, layout: xkb::LayoutIndex) -> Option<char> {
+    if !(10..=19).contains(&keycode.raw()) {
+        return None;
+    }
+    let keymap = state.get_keymap();
+    let digit = |sym: &Keysym| {
+        (Keysym::_0.raw()..=Keysym::_9.raw())
+            .contains(&sym.raw())
+            .then(|| char::from(b'0' + (sym.raw() - Keysym::_0.raw()) as u8))
+    };
+    if keymap
+        .key_get_syms_by_level(keycode, layout, 0)
+        .iter()
+        .any(|sym| digit(sym).is_some())
+    {
+        return None;
+    }
+    (0..keymap.num_levels_for_key(keycode, layout))
+        .find_map(|level| {
+            keymap
+                .key_get_syms_by_level(keycode, layout, level)
+                .iter()
+                .find_map(digit)
+        })
+        .or_else(|| guess_ascii(keycode, false))
+}
