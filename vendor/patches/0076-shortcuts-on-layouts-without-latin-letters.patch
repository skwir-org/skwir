+/// Whether each layout of a keymap is Latin: gives a letter from a to z at
+/// the first level of some key (as Firefox's `IsLatinGroup` asks). Kept with
+/// the keymap last asked about, which it holds so no other is made at its
+/// address meanwhile.
+#[cfg(any(feature = "wayland", feature = "x11"))]
+fn latin_layouts(keymap: &xkb::Keymap) -> std::rc::Rc<[bool]> {
+    thread_local! {
+        static KEPT: RefCell<Option<(xkb::Keymap, std::rc::Rc<[bool]>)>> =
+            const { RefCell::new(None) };
+    }
+    KEPT.with(|kept| {
+        let mut kept = kept.borrow_mut();
+        if let Some((cached, latin)) = kept.as_ref()
+            && cached.get_raw_ptr() == keymap.get_raw_ptr()
+        {
+            return latin.clone();
+        }
+        let latin: std::rc::Rc<[bool]> = (0..keymap.num_layouts())
+            .map(|layout| {
+                (keymap.min_keycode().raw()..=keymap.max_keycode().raw()).any(|code| {
+                    keymap
+                        .key_get_syms_by_level(Keycode::new(code), layout, 0)
+                        .iter()
+                        .any(|sym| (Keysym::a.raw()..=Keysym::z.raw()).contains(&sym.raw()))
+                })
+            })
+            .collect();
+        *kept = Some((keymap.clone(), latin.clone()));
+        latin
+    })
+}
