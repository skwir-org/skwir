+/// SKWIR: a drag's image: a surface showing one wl_shm buffer.
+struct DragIcon {
+    surface: wl_surface::WlSurface,
+    buffer: wl_buffer::WlBuffer,
+    pool: wl_shm_pool::WlShmPool,
+    _file: std::fs::File,
+}
+
+impl DragIcon {
+    /// `icon` in a buffer of its own on a new surface, as wl_shm takes it:
+    /// ARGB8888, premultiplied.
+    fn new(globals: &Globals, icon: &ExternalDragIcon) -> Option<Self> {
+        use std::os::fd::AsFd;
+        use std::os::unix::fs::FileExt;
+        let (width, height) = (icon.width, icon.height);
+        let size = (width as usize)
+            .checked_mul(height as usize)?
+            .checked_mul(4)?;
+        if size == 0 || icon.rgba.len() != size || size > i32::MAX as usize {
+            return None;
+        }
+        let mut pixels = Vec::with_capacity(size);
+        for px in icon.rgba.chunks_exact(4) {
+            let alpha = u32::from(px[3]);
+            let premultiply = |c: u8| ((u32::from(c) * alpha + 127) / 255) as u8;
+            pixels.extend_from_slice(&[
+                premultiply(px[2]),
+                premultiply(px[1]),
+                premultiply(px[0]),
+                px[3],
+            ]);
+        }
+        let file = shm_file(size)?;
+        file.write_all_at(&pixels, 0).ok()?;
+        let pool = globals
+            .shm
+            .create_pool(file.as_fd(), size as i32, &globals.qh, ());
+        let buffer = pool.create_buffer(
+            0,
+            width as i32,
+            height as i32,
+            (width * 4) as i32,
+            wl_shm::Format::Argb8888,
+            &globals.qh,
+            (),
+        );
+        let surface = globals.compositor.create_surface(&globals.qh, ());
+        Some(Self {
+            surface,
+            buffer,
+            pool,
+            _file: file,
+        })
+    }
+
+    /// Gives the surface its pixels once `start_drag` made it the drag's
+    /// icon, its hotspot under the pointer.
+    fn show(&self, icon: &ExternalDragIcon) {
+        let (x, y) = (-(icon.hotspot_x as i32), -(icon.hotspot_y as i32));
+        if self.surface.version() >= wl_surface::REQ_OFFSET_SINCE {
+            self.surface.attach(Some(&self.buffer), 0, 0);
+            self.surface.offset(x, y);
+        } else {
+            self.surface.attach(Some(&self.buffer), x, y);
+        }
+        self.surface
+            .damage_buffer(0, 0, icon.width as i32, icon.height as i32);
+        self.surface.commit();
+    }
+
+    fn destroy(self) {
+        self.buffer.destroy();
+        self.pool.destroy();
+        self.surface.destroy();
+    }
+}
+
+/// SKWIR: an anonymous file of `size` bytes for a wl_shm pool, under
+/// /dev/shm where there is one, unlinked at once so it never outlives its
+/// descriptor.
+fn shm_file(size: usize) -> Option<std::fs::File> {
+    use std::sync::atomic::{AtomicU32, Ordering};
+    static COUNTER: AtomicU32 = AtomicU32::new(0);
+    let dir = Path::new("/dev/shm");
+    let dir = if dir.is_dir() {
+        dir.to_path_buf()
+    } else {
+        std::env::temp_dir()
+    };
+    let path = dir.join(format!(
+        "gpui-drag-icon-{}-{}",
+        std::process::id(),
+        COUNTER.fetch_add(1, Ordering::Relaxed)
+    ));
+    let file = std::fs::File::options()
+        .read(true)
+        .write(true)
+        .create_new(true)
+        .open(&path)
+        .ok()?;
+    let _ = std::fs::remove_file(&path);
+    file.set_len(size as u64).ok()?;
+    Some(file)
 }
 
