+    /// Middle truncation within `max_lines` (two or more) wrapped lines: the lines before the
+    /// last stay as they wrap, and the affix takes the middle of the last one, which ends as
+    /// the text does (a long file name keeps its extension). Truncated to a single line's
+    /// width instead, the text would leave the other lines empty.
+    ///
+    /// A newline ends a line, as in `shape_text`: when one follows, the last line begins as its
+    /// own line does and ends as the text's last line does.
+    fn truncate_wrapped_line_middle<'a>(
+        &mut self,
+        text: SharedString,
+        wrap_width: Pixels,
+        max_lines: usize,
+        truncation_affix: &str,
+        runs: &'a [TextRun],
+    ) -> (SharedString, Cow<'a, [TextRun]>) {
+        // Where the last allowed line begins. The shaped layout indents no continuation line.
+        let mut lines_left = max_lines;
+        let mut line_start = 0;
+        let mut last_line_start = None;
+        for line in text.split('\n') {
+            let (wraps, last_wrap) = self
+                .wrap_line(
+                    &[LineFragment::text(line)],
+                    wrap_width,
+                    IndentAdjustment::NoIndent,
+                )
+                .take(lines_left - 1)
+                .fold((0, 0), |(count, _), boundary| (count + 1, boundary.ix));
+            if wraps == lines_left - 1 {
+                last_line_start = Some(line_start + last_wrap);
+                break;
+            }
+            lines_left -= wraps + 1;
+            line_start += line.len() + 1;
+        }
+        // Fewer lines than allowed: nothing to cut.
+        let Some(start) = last_line_start else {
+            return (text, Cow::Borrowed(runs));
+        };
+        let head_end = text[start..].find('\n').map_or(text.len(), |ix| start + ix);
+        // Newlines with nothing after them but whitespace leave nothing to show.
+        let end = head_end.max(text.trim_end().len());
+        let tail_start = text[start..end]
+            .rfind('\n')
+            .map_or(start, |ix| start + ix + 1);
+        if end == head_end
+            && text[start..head_end]
+                .chars()
+                .map(|c| self.width_for_char(c))
+                .sum::<Pixels>()
+                <= wrap_width
+        {
+            return (text, Cow::Borrowed(runs));
+        }
+
+        // The earlier lines already say how the text begins: the front takes up to half of
+        // what the affix leaves, and the end the rest.
+        let affix_width: Pixels = truncation_affix
+            .chars()
+            .map(|c| self.width_for_char(c))
+            .sum();
+        let budget = wrap_width - affix_width;
+        let mut front_width = px(0.);
+        let mut front_end_ix = start;
+        for (ix, c) in text[start..head_end].char_indices() {
+            let char_width = self.width_for_char(c);
+            if front_width + char_width > budget / 2. {
+                break;
+            }
+            front_width += char_width;
+            front_end_ix = start + ix + c.len_utf8();
+        }
+        let back_from = tail_start.max(front_end_ix);
+        let mut back_width = px(0.);
+        let mut back_start_ix = end;
+        for (ix, c) in text[back_from..end].char_indices().rev() {
+            let char_width = self.width_for_char(c);
+            if front_width + back_width + char_width > budget {
+                break;
+            }
+            back_width += char_width;
+            back_start_ix = back_from + ix;
+        }
+
+        let result = SharedString::from(format!(
+            "{}{truncation_affix}{}",
+            &text[..front_end_ix],
+            &text[back_start_ix..end]
+        ));
+        // What follows `end` goes, and its runs with it.
+        let mut runs = runs.to_vec();
+        let mut kept = end;
+        runs.retain_mut(|run| {
+            run.len = run.len.min(kept);
+            kept -= run.len;
+            run.len > 0
+        });
+        update_runs_after_middle_truncation(
+            truncation_affix,
+            &mut runs,
+            front_end_ix,
+            back_start_ix,
+        );
+        (result, Cow::Owned(runs))
+    }
