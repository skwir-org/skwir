+    #[test]
+    fn test_multiline_truncation_middle() {
+        let mut wrapper = build_wrapper();
+        let wrap_width = px(72.);
+        let mut elide = |text: &'static str, run_lens: &[usize], max_lines: usize| {
+            let runs = generate_test_runs(run_lens);
+            let (result, result_runs) = wrapper.truncate_wrapped_line(
+                text.into(),
+                wrap_width,
+                max_lines,
+                "…",
+                &runs,
+                TruncateFrom::Middle,
+            );
+            assert_eq!(
+                result_runs.iter().map(|run| run.len).sum::<usize>(),
+                result.len()
+            );
+            // Lines with nothing to show are not counted.
+            let lines = result
+                .trim_end()
+                .split('\n')
+                .map(|line| {
+                    wrapper
+                        .wrap_line(
+                            &[LineFragment::text(line)],
+                            wrap_width,
+                            IndentAdjustment::NoIndent,
+                        )
+                        .count()
+                        + 1
+                })
+                .sum::<usize>();
+            assert!(lines <= max_lines, "'{result}' takes {lines} lines");
+            let runs = result_runs.iter().map(|run| run.len).collect::<Vec<_>>();
+            (result.to_string(), runs)
+        };
+
+        // 72 px holds seven characters: the last line is three, the ellipsis, three.
+        assert_eq!(elide("aa bbb cccc ddddd.zip", &[21], 2).0, "aa bbb ccc…zip");
+        assert_eq!(
+            elide("aa bbb cccc ddddd eeee.zip", &[26], 3).0,
+            "aa bbb cccc ddd…zip"
+        );
+        // One word, broken where it overflows.
+        assert_eq!(
+            elide("abcdefghijklmnopqrstuvwxyz.zip", &[30], 2).0,
+            "abcdefghij…zip"
+        );
+        // It fits: untouched, and so are its runs.
+        assert_eq!(
+            elide("aa bbb cccc", &[3, 8], 2),
+            ("aa bbb cccc".into(), vec![3, 8])
+        );
+        // The runs lose what was removed; the ellipsis joins the run it began in.
+        assert_eq!(
+            elide("aa bbb cccc ddddd.zip", &[7, 6, 8], 2),
+            ("aa bbb ccc…zip".into(), vec![7, 3 + "…".len(), 3])
+        );
+        // A newline ends a line: the last one ends as the text does.
+        assert_eq!(
+            elide("hello\nworld\nmore.zip", &[20], 2).0,
+            "hello\nwor…zip"
+        );
+        assert_eq!(elide("hello\nworld", &[11], 2).0, "hello\nworld");
+        // Nothing to show after a newline: it fits, or its own line keeps its end.
+        assert_eq!(elide("hello\nworld\n", &[12], 2).0, "hello\nworld\n");
+        assert_eq!(
+            elide("hello\nworld.zip\n ", &[6, 11], 2),
+            ("hello\nwor…zip".into(), vec![6, 3 + "…".len(), 3])
+        );
+    }
