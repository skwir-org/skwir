+    /// The keystroke of the space bar with `held` down (evdev keycodes plus
+    /// eight: 50 Shift, 108 AltGr) on `layout(variant)` with `options`.
+    #[cfg(any(feature = "wayland", feature = "x11"))]
+    fn space_with(
+        layout: &str,
+        variant: &str,
+        options: Option<&str>,
+        held: &[u32],
+        modifiers: gpui::Modifiers,
+    ) -> gpui::Keystroke {
+        let context = xkb::Context::new(xkb::CONTEXT_NO_FLAGS);
+        let keymap = xkb::Keymap::new_from_names(
+            &context,
+            "evdev",
+            "pc105",
+            layout,
+            variant,
+            options.map(str::to_owned),
+            xkb::COMPILE_NO_FLAGS,
+        )
+        .expect("a layout of xkeyboard-config");
+        let mut state = State::new(&keymap);
+        for &key in held {
+            state.update_key(Keycode::new(key), xkb::KeyDirection::Down);
+        }
+        keystroke_from_xkb(&state, modifiers, Keycode::new(65))
+    }
+
+    #[cfg(any(feature = "wayland", feature = "x11"))]
+    #[test]
+    fn the_space_bar_with_shift_is_space_whatever_it_types() {
+        let control_shift = gpui::Modifiers {
+            control: true,
+            shift: true,
+            ..Default::default()
+        };
+        // French Ergo-L: Shift+Space types a narrow no-break space.
+        let ergol = space_with("fr", "ergol", None, &[50], control_shift);
+        assert_eq!(ergol.key, "space");
+        assert!(ergol.modifiers.control && ergol.modifiers.shift);
+        assert_eq!(ergol.key_char.as_deref(), Some("\u{202f}"));
+        // A zero-width non-joiner on Shift+Space, as Persian typists set it.
+        let zwnj = space_with("ir", "", Some("nbsp:zwnj2"), &[50], control_shift);
+        assert_eq!(zwnj.key, "space");
+        assert_eq!(zwnj.key_char.as_deref(), Some("\u{200c}"));
+        // What AltGr gives stays its own: AFNOR's no-break space.
+        let afnor = space_with("fr", "afnor", None, &[108], gpui::Modifiers::default());
+        assert_eq!(afnor.key_char.as_deref(), Some("\u{a0}"));
+        assert_ne!(afnor.key, "space");
+    }
