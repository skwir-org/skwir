+/// Whether `keycode` is a key whose unshifted symbol is Space, at the level
+/// Shift alone gives it: as Qt matches a shortcut held with Shift by the
+/// key's unshifted symbol. What AltGr gives (level three and above) stays
+/// its own.
+#[cfg(any(feature = "wayland", feature = "x11"))]
+fn shifts_space(state: &State, keycode: Keycode) -> bool {
+    let layout = state.key_get_layout(keycode);
+    state.key_get_level(keycode, layout) == 1
+        && state.get_keymap().key_get_syms_by_level(keycode, layout, 0) == [Keysym::space]
+}
