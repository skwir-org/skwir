+/// The samples of a component decoded at an eighth, one a block of the
+/// `blocks_wide` of each row, drawn from its DC coefficients alone as the
+/// 1x1 IDCT draws them. What was kept of a DC is the whole one with its
+/// `bits_left` lowest bits cleared, at or below it: drawn as it is, every
+/// picture came out darker and its colours shifted. A block is drawn halfway
+/// between the least and the most its whole DC may draw, half of them
+/// rounding up, as on a chessboard.
+fn dc_samples(dc: &[i16], quantization: u16, bits_left: u8, blocks_wide: usize) -> Vec<u8> {
+    let quantization = i32::from(quantization);
+    let spread = Wrapping(((1i32 << bits_left) - 1).wrapping_mul(quantization));
+    dc.iter()
+        .enumerate()
+        .map(|(block, &dc)| {
+            let least = Wrapping(i32::from(dc) * quantization);
+            let (least, most) = (idct_1x1(least), idct_1x1(least + spread));
+            let up = (block % blocks_wide.max(1) + block / blocks_wide.max(1)) & 1;
+            ((usize::from(least) + usize::from(most) + up) / 2) as u8
+        })
+        .collect()
+}
