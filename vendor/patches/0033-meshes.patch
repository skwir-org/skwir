+        let indices = vec![0, 1, 4, 0, 4, 3, 1, 2, 5, 1, 5, 4];
+        let roof = std::sync::Arc::new(gpui::Mesh::new(positions, indices).unwrap());
+        upload(&mut renderer, &roof);
