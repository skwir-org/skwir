+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{ImageId, RenderImageParams, platform::blade::BladeContext};
+
+    fn insert(atlas: &BladeAtlas, key: &AtlasKey, width: i32) -> AtlasTile {
+        let size = Size {
+            width: DevicePixels(width),
+            height: DevicePixels(1024),
+        };
+        atlas
+            .get_or_insert_with(key, &mut || {
+                Ok(Some((size, Cow::Owned(vec![0; width as usize * 1024 * 4]))))
+            })
+            .unwrap()
+            .unwrap()
+    }
+
+    fn key(id: usize) -> AtlasKey {
+        RenderImageParams {
+            image_id: ImageId(id),
+            frame_index: 0,
+        }
+        .into()
+    }
+
+    #[test]
+    #[ignore = "requires a working Blade GPU context"]
+    fn removed_texture_cancels_pending_work_before_slot_reuse() {
+        let context = BladeContext::new().unwrap();
+        let atlas = BladeAtlas::new(&context.gpu);
+        let old = insert(&atlas, &key(1), 2048);
+        atlas.remove(&key(1));
+        {
+            let state = atlas.0.lock();
+            assert!(state.initializations.is_empty());
+            assert!(state.uploads.is_empty());
+            assert_eq!(state.retired_textures.len(), 1);
+        }
+        // Reuse the index with a smaller texture: old uploads must not target it.
+        let new = insert(&atlas, &key(2), 1024);
+        assert_eq!(old.texture_id, new.texture_id);
+        {
+            let state = atlas.0.lock();
+            assert_eq!(state.initializations.len(), 1);
+            assert_eq!(state.uploads.len(), 1);
+            assert_eq!(state.uploads[0].bounds.size.width, DevicePixels(1024));
+        }
+        let mut encoder = context.gpu.create_command_encoder(gpu::CommandEncoderDesc {
+            name: "atlas regression",
+            buffer_count: 2,
+        });
+        encoder.start();
+        atlas.before_frame(&mut encoder);
+        let submitted = context.gpu.submit(&mut encoder);
+        atlas.after_frame(&submitted); // No previous submission in this test.
+        assert!(atlas.0.lock().retired_textures.is_empty());
+        atlas.remove(&key(2));
+        // Removal must not destroy a resource referenced by submitted work.
+        assert_eq!(atlas.0.lock().retired_textures.len(), 1);
+        assert!(context.gpu.wait_for(&submitted, 10_000));
+        atlas.destroy();
+        context.gpu.destroy_command_encoder(&mut encoder);
+    }
+
+    #[test]
+    #[ignore = "requires a working Blade GPU context"]
+    fn removed_texture_can_be_flushed_without_a_replacement() {
+        let context = BladeContext::new().unwrap();
+        let atlas = BladeAtlas::new(&context.gpu);
+        insert(&atlas, &key(1), 2048);
+        atlas.remove(&key(1));
+        atlas.remove(&key(1)); // Idempotent removal.
+        let mut encoder = context.gpu.create_command_encoder(gpu::CommandEncoderDesc {
+            name: "atlas removed before present",
+            buffer_count: 2,
+        });
+        encoder.start();
+        // Reproduces the original vacant-slot panic deterministically.
+        atlas.before_frame(&mut encoder);
+        let submitted = context.gpu.submit(&mut encoder);
+        atlas.after_frame(&submitted);
+        assert!(atlas.0.lock().retired_textures.is_empty());
+        assert!(context.gpu.wait_for(&submitted, 10_000));
+        atlas.destroy();
+        context.gpu.destroy_command_encoder(&mut encoder);
+    }
+}
