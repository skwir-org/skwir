0043 activate-with-token: Window::activate_window_with_token brings the window forward with a token the desktop gave (Wayland's xdg-activation, as a notification's click hands it), else as activate_window

diff --git a/crates/gpui/src/platform.rs b/crates/gpui/src/platform.rs
index 0d56a83..539fc1c 100644
--- a/crates/gpui/src/platform.rs
+++ b/crates/gpui/src/platform.rs
@@ -1312,6 +1312,13 @@ pub trait PlatformWindow: HasWindowHandle + HasDisplayHandle {
         answers: &[PromptButton],
     ) -> Option<oneshot::Receiver<usize>>;
     fn activate(&self);
+    /// Bring the window forward with `token`, the desktop's leave to do so
+    /// (Wayland's xdg-activation, as a notification's click hands it);
+    /// where none works so, as `activate`.
+    fn activate_with_token(&self, token: &str) {
+        let _ = token;
+        self.activate();
+    }
     /// Requests that the operating system draw attention to this window.
