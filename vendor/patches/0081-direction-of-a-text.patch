+
+    /// A text reads in its first strong character's direction (UAX #9's
+    /// P2 and P3), past digits, punctuation, spaces, paragraph separators
+    /// and what an isolate holds; none where it has no such character.
+    #[test]
+    fn a_text_reads_in_its_first_strong_character_s_direction() {
+        use LayoutDirection::{LeftToRight, RightToLeft};
+        for (text, direction) in [
+            ("Hello", Some(LeftToRight)),
+            ("12. Hello", Some(LeftToRight)),
+            ("Été", Some(LeftToRight)),
+            ("Ελλάδα", Some(LeftToRight)),
+            ("日本語", Some(LeftToRight)),
+            ("שלום עולם", Some(RightToLeft)),
+            ("مرحبا بالعالم", Some(RightToLeft)),
+            ("2026 — שלום", Some(RightToLeft)),
+            ("« مرحبا » hello", Some(RightToLeft)),
+            ("Hello שלום", Some(LeftToRight)),
+            ("\n\nمرحبا", Some(RightToLeft)),
+            // An isolated name tells nothing of the sentence around it.
+            ("“\u{2068}שלום\u{2069}” moved", Some(LeftToRight)),
+            ("\u{2067}abc\u{2069}", None),
+            ("12, 13 (-1)", None),
+            ("", None),
+        ] {
+            assert_eq!(LayoutDirection::of_text(text), direction, "{text:?}");
+        }
+    }
 }
