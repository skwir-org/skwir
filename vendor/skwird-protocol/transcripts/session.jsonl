# A session of protocol 0, every message once: what a client says (>)
# and what a user's engine answers (<). Paths and names are synthetic.
#
# Hello first: the versions the client speaks, and its name, which keeps
# its registrations apart from another client's.
> {"id":1,"hello":{"versions":[0],"client":"skwir"}}
< {"id":1,"hello":{"version":0,"scope":"user","engine":"skwird 0.0.0","roots":["/home/user"]}}
# How far answers below a root can be trusted: names checked, attributes
# as of the last whole crawl, and a subtree not covered.
> {"id":2,"coverage":{"root":"/home/user/Documents"}}
< {"id":2,"coverage":{"names":{"checked":{"sec":1795000000,"nsec":0}},"attrs":{"as_of":{"sec":1794990000,"nsec":0}},"holes":[{"path":"/home/user/Documents/shut","why":"denied"},{"path":"/home/user/Documents/broken","why":{"failed":5}},{"path":"/home/user/Documents/as of monday","why":"snapshot"}]}}
