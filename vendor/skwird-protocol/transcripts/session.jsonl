< {"id":4,"done":{"coverage":{"names":{"checked":{"sec":1795000100,"nsec":5}},"attrs":{"as_of":{"sec":1794990000,"nsec":0}}},"count":2,"truncated":false,"cancelled":false}}
# A glob, sizes and times; cancelled before it ends.
