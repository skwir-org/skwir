// The interface between skwir and a plugin that runs as a WebAssembly
// module (ADR-046). Everything a plugin reaches outside itself goes
// through `host`; what it answers goes through `guest`. The methods and
// their JSON are the protocol's (docs/plugins/protocol.md), as a plugin
// that runs as a program speaks them over its standard input and output.
package skwir:plugin@0.1.0;

/// What skwir does for a plugin.
interface host {
    /// Bytes of a file the call being answered names, by its handle: from
    /// `offset`, at most `length`. Refused for a handle of no file of the
    /// call, and for a plugin that may not read what files hold.
    read: func(file: u32, offset: u64, length: u32) -> result<list<u8>, string>;
    /// A line for skwir's log, at `level`: error, warn, info or debug.
    log: func(level: string, message: string);
}

/// What a plugin answers.
interface guest {
    /// One method of the protocol, its parameters and its answer as JSON.
    call: func(method: string, params: string) -> result<string, string>;
}

world plugin {
    import host;
    export guest;
}
