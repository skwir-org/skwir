# Load the flake dev shell automatically (direnv + nix-direnv).
watch_file flake.nix flake.lock
# The dev shell attribute to load. Keep a single `use flake`: two calls each
# wipe the other's nix-direnv cache and rebuild on every prompt.
SKWIR_FLAKE_ATTR=.
# Local overrides, git-ignored: e.g. `SKWIR_FLAKE_ATTR=.#pdf` for the PDFium runtime.
source_env_if_exists .envrc.local
use flake "$SKWIR_FLAKE_ATTR"
