[Desktop Entry]
Type=Application
Name=Skwir Preview
# Translators: what kind of program Skwir Preview is, shown under its
# name. It shows one file, or several, in a window of its own.
GenericName=File Viewer
# Translators: what Skwir Preview does, shown where a file is opened with
# it (Open With).
Comment=Show a file's preview
Exec=skwir view %F
Icon=org.skwir.skwir
Terminal=false
NoDisplay=true
StartupNotify=true
Categories=Utility;Viewer;
# Every type of a kind Skwir previews, as the type database groups them
# (ADR-151, 8): listed by tools/package/viewer_types.py, never by hand.
