[Desktop Entry]
Type=Application
Name=skwir view
# Translators: what kind of program skwir view is, shown under its
# name. It shows one file, or several, in a window of its own.
GenericName=File Viewer
# Translators: what skwir view does, shown where a file is opened with
# it (Open With).
Comment=Show a file's preview
Exec=skwir view %F
Icon=org.skwir.skwir
Terminal=false
NoDisplay=true
StartupNotify=true
Categories=Utility;Viewer;
# One type, application/octet-stream (ADR-151, 8): a desktop that offers
# what declares it for every file offers skwir view so, and GIO for files
# of no known type. A specific type declared would make it that type's
# opener wherever the lists name none and its ID sorts first (VLC's
# videos), or the type is left to its parent (Markdown).
MimeType=application/octet-stream;
