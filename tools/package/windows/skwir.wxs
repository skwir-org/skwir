<?xml version="1.0" encoding="utf-8"?>
<!-- skwir's Windows installer (ADR-074), made on Linux by msitools' wixl,
     which reads WiX 3's format, from the folder tools/package/windows.sh
     stages: `wixl -a x64 -D Version=… -D Dist=<folder> -D Icon=<.ico> -D Win64=yes
     skwir.wxs files.wxs`.
     files.wxs, made there by wixl-heat, holds every file of the folder
     (the programs, PDFium, the licences, the type database), so nothing
     here lists them again, but skwird.exe, named here for the action that
     runs it. Per user, in %LocalAppData%\Programs\skwir, no
     administrator asked; a Start menu entry. Unsigned. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="skwir" Manufacturer="skwir" Language="1033"
           Version="$(var.Version)" UpgradeCode="6f1c2b7e-3d9a-4c5e-9b8f-2a7d4e1c0b35">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="skwir, a file manager" />
    <MajorUpgrade DowngradeErrorMessage="A newer skwir is already installed." />
    <Media Id="1" Cabinet="skwir.cab" EmbedCab="yes" />
    <!-- The icon skwir.exe carries (crates/skwir/build.rs), taken out of
         it, for its shortcut and the list of installed programs: an Icon
         holds its whole file, which skwir.exe would double. -->
    <Icon Id="skwir.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="skwir.ico" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="LocalPrograms" Name="Programs">
          <Directory Id="INSTALLDIR" Name="skwir">
            <!-- skwird, carried beside skwir (ADR-050, amended
                 2026-11-26), the program the action below runs. -->
            <Component Id="Skwird" Guid="*" Win64="$(var.Win64)">
              <File Id="skwird.exe" Source="$(var.Dist)/skwird.exe" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenu" Guid="4b0a1e52-8c7d-4f3e-a6b9-1d2c5e8f7a40">
          <Shortcut Id="StartMenuShortcut" Name="skwir" Target="[INSTALLDIR]skwir.exe"
                    WorkingDirectory="INSTALLDIR" Icon="skwir.ico" />
          <!-- What a per-user component is known by: a value of its own. -->
          <RegistryValue Root="HKCU" Key="Software\skwir" Name="StartMenu" Type="integer"
                         Value="1" KeyPath="yes" />
          <!-- The name Windows shows the program's toasts under (ADR-114):
               wixl gives a shortcut no AppUserModelID, so the program's id
               is registered as unpackaged programs register theirs. -->
          <RegistryValue Root="HKCU" Key="Software\Classes\AppUserModelId\org.skwir.skwir"
                         Name="DisplayName" Type="string" Value="skwir" />
        </Component>
      </Directory>
    </Directory>
    <Feature Id="Main" Level="1">
      <ComponentRef Id="StartMenu" />
      <ComponentRef Id="Skwird" />
      <ComponentGroupRef Id="Files" />
    </Feature>
    <!-- skwird registers the task that starts it at its user's logon
         (`skwird logon add`) with the path of the program it runs, the
         skwirdw.exe beside it: the carried copy's, once its user asked
         that copy. Removed with skwir, that task would start nothing at
         each logon, so the carried skwird takes it back first, while its
         files are there (`skwird logon remove`), as its user, its answer
         ignored: where none was registered, it fails and nothing is lost.
         skwird 0.2.0 takes back the user's one task whichever copy
         registered it, a skwird installed on its own included, and leaves
         its engine running (ADR-074). skwird.exe, not skwirdw.exe: from
         skwirdw, which has no console, the schtasks.exe skwird starts
         opens a console window of its own all the same, and skwirdw makes
         skwird's state folder and log first.
         Not when an upgrade removes the older skwir: the newer puts
         skwird where the task names it. A per-user install is never
         elevated, so it cannot take back a system service; skwird's
         `service add`, an administrator's, is not for a copy in the user's
         own folder (ADR-074, amended 2026-11-26). The first step of the
         removal's script: wixl 0.106 places an action Before="RemoveFiles"
         ahead of InstallInitialize, outside the script, where a deferred
         action fails the removal (windows-check.sh reads its place). -->
    <CustomAction Id="SkwirdLogonRemove" FileKey="skwird.exe" ExeCommand="logon remove"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="SkwirdLogonRemove" After="InstallInitialize">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
