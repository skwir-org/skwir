<?xml version="1.0" encoding="utf-8"?>
<!-- skwir's Windows installer (ADR-074), made on Linux by msitools' wixl,
     which reads WiX 3's format, from the folder tools/package/windows.sh
     stages: `wixl -a x64 -D Version=… -D Dist=<folder> -D Icon=<.ico> -D Win64=yes
     skwir.wxs files.wxs`.
     files.wxs, made there by wixl-heat, holds every file of the folder
     (the programs, PDFium, the licences, the type database), so nothing
     here lists them again. Per user, in %LocalAppData%\Programs\skwir, no
     administrator asked; a Start menu entry. Unsigned. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="skwir" Manufacturer="skwir" Language="1033"
           Version="$(var.Version)" UpgradeCode="6f1c2b7e-3d9a-4c5e-9b8f-2a7d4e1c0b35">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="skwir, a file manager" />
    <MajorUpgrade DowngradeErrorMessage="A newer skwir is already installed." />
    <Media Id="1" Cabinet="skwir.cab" EmbedCab="yes" />
    <!-- The icon skwir.exe carries (crates/skwir/build.rs), taken out of
         it, for its shortcut and the list of installed programs: an Icon
         holds its whole file, which skwir.exe would double. -->
    <Icon Id="skwir.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="skwir.ico" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="LocalPrograms" Name="Programs">
          <Directory Id="INSTALLDIR" Name="skwir" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenu" Guid="4b0a1e52-8c7d-4f3e-a6b9-1d2c5e8f7a40">
          <Shortcut Id="StartMenuShortcut" Name="skwir" Target="[INSTALLDIR]skwir.exe"
                    WorkingDirectory="INSTALLDIR" Icon="skwir.ico" />
          <!-- What a per-user component is known by: a value of its own. -->
          <RegistryValue Root="HKCU" Key="Software\skwir" Name="StartMenu" Type="integer"
                         Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
    <Feature Id="Main" Level="1">
      <ComponentRef Id="StartMenu" />
      <ComponentGroupRef Id="Files" />
    </Feature>
  </Product>
</Wix>
