<!-- skwir's Windows installer (Phase 5, step K), for WiX 5 or later:
     `wix build skwir.wxs -d Version=0.1.0 -d Dist=..\..\..\target\dist`.
     Written on Linux, never built yet (ADR-035: 5b builds it). The helpers
     go beside skwir.exe, where it finds them. Unsigned. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="skwir" Manufacturer="skwir" Version="$(Version)"
           UpgradeCode="6f1c2b7e-3d9a-4c5e-9b8f-2a7d4e1c0b35" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer skwir is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- The icon skwir.exe carries (crates/skwir/build.rs), for its
         shortcut and the list of installed programs. -->
    <Icon Id="skwir.exe" SourceFile="$(Dist)\skwir.exe" />
    <Property Id="ARPPRODUCTICON" Value="skwir.exe" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="Programs" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="skwir">
          <Component Id="Programs" Guid="*">
            <File Source="$(Dist)\skwir.exe" KeyPath="yes">
              <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="skwir"
                        WorkingDirectory="INSTALLFOLDER" Icon="skwir.exe" Advertise="yes" />
            </File>
            <File Source="$(Dist)\skwir-pdf-worker.exe" />
            <File Source="$(Dist)\skwir-model-worker.exe" />
            <File Source="$(Dist)\skwir-module-worker.exe" />
            <!-- PDFium, beside its helper (ADR-041). -->
            <File Source="$(Dist)\pdfium.dll" />
          </Component>
          <!-- skwir's licence, and PDFium's with those of what it carries. -->
          <Directory Id="Licenses" Name="licenses">
            <Files Include="$(Dist)\licenses\**" />
          </Directory>
          <!-- The type database, beside skwir.exe (ADR-037): what
               tools/package/mime-database.sh puts in it. -->
          <Directory Id="Share" Name="share">
            <Directory Id="MimeFolder" Name="mime">
              <Component Id="MimeDatabase" Guid="*">
                <File Source="$(Dist)\share\mime\globs2" KeyPath="yes" />
                <File Source="$(Dist)\share\mime\aliases" />
                <File Source="$(Dist)\share\mime\generic-icons" />
                <File Source="$(Dist)\share\mime\icons" />
                <File Source="$(Dist)\share\mime\magic" />
                <File Source="$(Dist)\share\mime\subclasses" />
                <File Source="$(Dist)\share\mime\COPYING" />
                <File Source="$(Dist)\share\mime\README" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="Main">
      <ComponentRef Id="Programs" />
      <ComponentRef Id="MimeDatabase" />
    </Feature>
  </Package>
</Wix>
