pkgname = bibli
	license = Apache-2.0
	license = BSD-3-Clause
	license = GPL-3.0-only
	depends = libgcc
	depends = glibc
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = sqlite
	depends = fontconfig
	depends = vulkan-icd-loader
	depends = vulkan-driver
	depends = libarchive
	optdepends = gstreamer: audio and video playback
	optdepends = gst-plugins-base-libs: audio and video playback
	optdepends = gst-plugins-base: audio and video playback
	optdepends = gst-plugins-good: more audio and video formats
	optdepends = gst-plugins-bad: more audio and video formats
	optdepends = gst-plugins-ugly: more audio and video formats
	optdepends = gst-libav: more audio and video formats
	optdepends = poppler-glib: PDFs through Poppler, beside the PDFium bibli carries
	optdepends = bibli-mermaid: Mermaid diagrams drawn in Markdown previews
	optdepends = bibli-mupdf: the MuPDF engine, PDFs and books laid out into pages
	optdepends = bubblewrap: LibreOffice, ImageMagick and thumbnailers run isolated
	optdepends = libreoffice-fresh: office documents shown as pages
	optdepends = pandoc-cli: text documents read by Pandoc
	optdepends = imagemagick: pictures no thumbnailer draws
	optdepends = ffmpeg: still frames of films
	optdepends = perl-image-exiftool: writing and removing pictures locations
	optdepends = plocate: instant name searches over whole disks
	optdepends = udisks2: unmounting volumes from the sidebar

pkgname = bibli-mermaid
	pkgdesc = Mermaid diagrams drawn in bibli's Markdown previews
	depends = bibli
	depends = libgcc
	depends = glibc

pkgname = bibli-mupdf
	pkgdesc = bibli's MuPDF engine: PDFs, and books laid out into pages
